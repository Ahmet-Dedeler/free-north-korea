# Copy to .env.local (gitignored). Both are optional: without a key, analytics is off.

# PostHog project key (starts with phc_). It is a write-only key that ends up in the browser bundle anyway,
# but keep it out of the repo so forks don't report into the wrong project. In production it is set in Vercel.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Defaults to the US cloud. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_HOST=

# Night lights (NASA Black Marble), free Earthdata login
EARTHDATA_TOKEN=
# Ship positions and SAR detections, free non-commercial token
GFW_API_TOKEN=

# Google Earth Engine Cloud project IDs (not secrets, but account-specific)
EE_PROJECT=
EE_PROJECT_2=

# Planet (ai.planet.com) personal access tokens and user ids, for scripts/planet/build.py. n = 2, 3, 4
PV_PAT_2=
PV_UID_2=
PV_PAT_3=
PV_UID_3=
PV_PAT_4=
PV_UID_4=
